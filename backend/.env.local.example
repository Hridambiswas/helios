# backend/.env.local.example — template for the local demo.
#
# Copy this file to `backend/.env.local`, then replace the placeholders.
# `start_helios.command` will copy `backend/.env.local` to `backend/.env`
# on first run (only if `backend/.env` does not already exist).
#
# This file is a template. It MUST NOT contain real keys.

# ── LLM (Groq — planner / synthesizer / critic) ─────────────────────────────
GROQ_API_KEY=__PASTE_GROQ_KEY__
GROQ_MODEL=openai/gpt-oss-120b

# ── Verifier (Google Gemini — free tier) ────────────────────────────────────
GEMINI_API_KEY=__PASTE_GEMINI_KEY__
# gemini-3.8-flash hits 429 quota-exceeded almost immediately on the free
# tier; -flash-lite-latest returns in ~2s and stays within the daily cap.
GEMINI_MODEL=gemini-flash-lite-latest

# ── Debate pipeline models (013) ────────────────────────────────────────────
# Answerer (Gemini) drafts; advocate + skeptic (Groq, two families) debate;
# judge (Groq) writes the final answer.
ANSWERER_MODEL=gemini-flash-lite-latest
ADVOCATE_MODEL=openai/gpt-oss-120b
# Skeptic stays on Qwen for family diversity in the debate. Judge is on
# OpenAI's gpt-oss-120b because the Qwen judge was observed citing zero
# of six available web sources on ETH-style queries — fidelity to the
# retrieved evidence wins over family-diversity here. Scoring is still
# independent (runs on the Qwen skeptic model below), so the judge
# never grades its own work.
SKEPTIC_MODEL=qwen/qwen3.8-27b
JUDGE_MODEL=openai/gpt-oss-120b
SCORER_MODEL=qwen/qwen3.8-27b

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=__PASTE_RANDOM_HEX__
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# ── PostgreSQL (local Docker service) ───────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=helios
POSTGRES_USER=helios
POSTGRES_PASSWORD=helios_local_dev
DATABASE_URL=postgresql+asyncpg://helios:helios_local_dev@localhost:5432/helios

# ── Redis / Celery (local Docker service) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── MinIO (local Docker service) ────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_local_dev
MINIO_SECRET_KEY=minio_local_dev_secret
MINIO_BUCKET=helios-docs
MINIO_SECURE=false

# ── ChromaDB (local Docker service, host port 8001) ─────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=helios

# ── CORS — allow the Vite dev server ────────────────────────────────────────
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── App ─────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Verifier (Gemini) — demo default is OFF ─────────────────────────────────
# Gemini's free tier is routinely 503/504 for gemini-3.8-flash. The demo
# answer with sources + critic scores (from Groq) is already end-to-end.
# Flip to true + use a stable Gemini model if you want the second-pass check.
VERIFIER_ENABLED=false
VERIFIER_TIMEOUT_SECONDS=20

# ── OAuth callback (unused for the local demo, kept for config parity) ──────
OAUTH_BACKEND_CALLBACK=http://localhost:8000/api/v1/auth/github/callback
