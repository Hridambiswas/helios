# DuckDNS credentials for the updater.
# Install location on the VM: /etc/helios/duckdns.env (chmod 600).

# Subdomain only — NOT the full duckdns.org name.
# Example: for helios-hridam.duckdns.org, set DUCKDNS_DOMAIN=helios-hridam
DUCKDNS_DOMAIN=helios-hridam

# Account token from https://www.duckdns.org (visible after login).
DUCKDNS_TOKEN=paste-your-token-here
